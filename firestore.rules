rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function self(uid){return signedIn() && request.auth.uid == uid;}
  function admin(){return signedIn() && request.auth.token.admin == true;}
  match /users/{uid} { allow read: if self(uid) || admin(); allow create: if self(uid) && request.resource.data.uid == uid && request.resource.data.usernameLower == request.auth.token.email.split('@')[0] && request.resource.data.status == 'active' && request.resource.data.isAdmin == false && request.resource.data.keys().hasOnly(['uid','username','usernameLower','status','isAdmin','createdAt']); allow update, delete: if false; }
  match /usernameReservations/{name} { allow read: if signedIn(); allow create: if signedIn() && name == request.auth.token.email.split('@')[0] && request.resource.data.uid == request.auth.uid && request.resource.data.username == name && request.resource.data.keys().hasOnly(['uid','username','createdAt']); allow update, delete: if false; }
  match /accounts/{uid} { allow read: if self(uid) || admin(); allow create: if self(uid) && request.resource.data.uid == uid && request.resource.data.balance == 0 && request.resource.data.keys().hasOnly(['uid','balance','updatedAt']); allow update, delete: if false; }
  match /ledger/{id} { allow read: if signedIn() && request.auth.uid in resource.data.participantUids || admin(); allow write: if false; }
  match /listings/{id} { allow read: if resource.data.status == 'active' || (signedIn() && resource.data.sellerUid == request.auth.uid) || admin(); allow write: if false; }
  match /orders/{id} { allow read: if signedIn() && (resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid) || admin(); allow write: if false; }
  match /holdings/{id} { allow read: if signedIn() && resource.data.uid == request.auth.uid || admin(); allow write: if false; }
  match /trades/{id} { allow read: if signedIn() && resource.data.uid == request.auth.uid || admin(); allow write: if false; }
  match /marketPrices/{ticker} { allow read: if signedIn(); allow write: if admin(); }
  match /redeemCodes/{id} { allow read: if admin(); allow write: if false; }
  match /redeemClaims/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin()); allow write: if false; }
  match /gameLimits/{id} { allow read, write: if false; }
  match /adminAudit/{id} { allow read: if admin(); allow write: if false; }
  match /operations/{id} { allow read, write: if false; }
  match /announcements/{id} { allow read: if signedIn(); allow write: if admin(); }
  match /{document=**} { allow read, write: if false; }
 }
}
